---
import { Image } from "astro:assets";
import imgMap from "../assets/map.jpg";

const currentYear = new Date().getFullYear();

const hours = [
  { day: "Lundi au Vendredi", time: "08h00 - 15h00" },
  { day: "Samedi & Dimanche", time: "Fermé" }
];
---

<footer id="info" class="bg-slate-900 text-slate-300 pt-20 pb-8 border-t-4 border-amber-500">
  <div class="max-w-6xl mx-auto px-6 lg:px-8">
    
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 mb-16 items-center">
      
      <div class="space-y-10">
        
        <div>
          <h2 class="font-display text-4xl text-amber-500 mb-4">Chez Bibiche</h2>
          <p class="text-slate-400 text-lg leading-relaxed max-w-md">
            Votre pause gourmande au cœur de la Zone Industrielle. Mangez bien, mangez vite, et reprenez des forces.
          </p>
        </div>

        <div class="bg-slate-800/50 p-6 rounded-2xl border border-slate-700/50 hover:border-amber-500/50 transition-colors">
          <p class="text-sm font-bold uppercase tracking-wider text-slate-400 mb-2">Passez commande</p>
          <a href="tel:0400000000" class="inline-block text-3xl md:text-4xl font-bold text-white hover:text-amber-500 transition-colors">
            📞 04 00 00 00 00
          </a>
        </div>

        <div class="grid sm:grid-cols-2 gap-8">
          <div>
            <h3 class="text-sm font-bold uppercase tracking-wider text-amber-500 mb-3">Adresse</h3>
            <address class="not-italic text-slate-300">
              1ère Avenue, Z.I. de Carros<br />
              06510 Carros
            </address>
            <a href="https://maps.google.com" target="_blank" class="inline-block mt-3 text-sm font-medium text-white border-b border-slate-500 hover:text-amber-500 hover:border-amber-500 transition-colors pb-0.5">
              Itinéraire GPS →
            </a>
          </div>
          
          <div>
            <h3 class="text-sm font-bold uppercase tracking-wider text-amber-500 mb-3">Horaires</h3>
            <ul class="space-y-3">
              {hours.map((h) => (
                <li class="flex flex-col">
                  <span class="font-medium text-white">{h.day}</span>
                  <span class={h.time === "Fermé" ? "text-slate-500 italic text-sm mt-0.5" : "text-amber-400 font-bold mt-0.5"}>
                    {h.time}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        </div>
        
      </div>

      <div class="relative h-[350px] lg:h-[450px] rounded-3xl overflow-hidden shadow-2xl ring-1 ring-white/10 group">
        <a href="https://maps.google.com" target="_blank" class="block w-full h-full cursor-pointer" aria-label="Voir sur Google Maps">
          <Image 
            src={imgMap}
            alt="Plan d'accès Chez Bibiche à Carros" 
            class="absolute inset-0 w-full h-full object-cover opacity-80 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500"
            format="webp"
          />
          <div class="absolute inset-0 bg-slate-900/20 pointer-events-none group-hover:bg-transparent transition-colors duration-500"></div>
        </a>
      </div>
      
    </div>

    <div class="pt-8 border-t border-slate-800 flex flex-col md:flex-row justify-between items-center gap-4 text-xs font-medium text-slate-500">
      <p>© {currentYear} Chez Bibiche. Tous droits réservés.</p>
      
      <div class="flex gap-6 items-center">
        <a href="/mentions-legales" class="hover:text-amber-500 transition-colors">Mentions légales</a>
        <span class="w-1 h-1 bg-slate-700 rounded-full"></span>
        <span>Création web : <a href="https://william-sart.fr" target="_blank" rel="noopener noreferrer" class="text-slate-300 hover:text-amber-500 transition-colors">William Sart</a></span>
      </div>
    </div>

  </div>
</footer>