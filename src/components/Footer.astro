---
const currentYear = new Date().getFullYear();
---

<footer class="bg-black pt-16 pb-8 border-t border-bibiche-vert/20">
  <div class="max-w-6xl mx-auto px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-16">
      <div>
        <a
          href="/"
          class="font-display font-black text-3xl text-bibiche-terra tracking-tighter uppercase block mb-4 hover:text-bibiche-vert transition-colors"
        >
          Chez Bibiche
        </a>
        <p class="text-sm text-white/60 leading-relaxed mb-6">
          Votre pause gourmande et faite maison au cœur de la Zone d'Activité de
          la Grave. Des produits frais, un service rapide, et le sourire en
          prime.
        </p>
      </div>

      <div>
        <h3
          class="font-bold mb-5 text-white uppercase tracking-[0.15em] text-xs"
        >
          Accès & Contact
        </h3>
        <ul class="space-y-4 text-sm text-white/70">
          <li class="flex items-start gap-3">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-5 h-5 text-bibiche-vert shrink-0 mt-0.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
              ></path>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            <span>
              497 Zone d'Activité de la Grave<br />
              06510 Carros, France
            </span>
          </li>
          <li class="flex items-center gap-3">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-5 h-5 text-bibiche-vert shrink-0"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
              ></path>
            </svg>
            <a
              href="tel:0400000000"
              class="hover:text-bibiche-terra transition-colors"
              >04 00 00 00 00</a
            >
          </li>
        </ul>
      </div>

      <div>
        <h3
          class="font-bold mb-5 text-white uppercase tracking-[0.15em] text-xs"
        >
          Horaires d'ouverture
        </h3>
        <ul class="space-y-3 text-sm text-white/70">
          <li class="flex justify-between border-b border-white/10 pb-3">
            <span>Lundi - Vendredi</span>
            <span class="font-bold text-white">11h00 - 15h00</span>
          </li>
          <li class="flex justify-between pt-1">
            <span>Samedi & Dimanche</span>
            <span
              class="text-bibiche-terra font-bold uppercase text-xs tracking-wider"
              >Fermé</span
            >
          </li>
        </ul>
      </div>
    </div>

    <div
      class="pt-8 border-t border-white/10 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-white/40"
    >
      <div
        class="flex flex-wrap justify-center md:justify-start gap-4 md:gap-6"
      >
        <span
          >&copy; {currentYear} ML SNACKING (Chez Bibiche). Tous droits réservés.</span
        >
        <a
          href="/mentions-legales"
          class="hover:text-bibiche-terra transition-colors">Mentions Légales</a
        >
      </div>

      <div class="text-center md:text-right mt-2 md:mt-0">
        Créé par <a
          href="https://william-sart.fr"
          target="_blank"
          rel="noopener noreferrer"
          class="text-bibiche-vert font-bold hover:text-white transition-colors"
          >William Sart</a
        >
      </div>
    </div>
  </div>
</footer>
