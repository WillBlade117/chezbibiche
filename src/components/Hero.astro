---
/* src/components/Hero.astro */
---

<section
  class="relative bg-white min-h-[calc(100vh-5rem)] overflow-hidden flex items-center border-b border-black/5 py-12 lg:py-0"
>
  <div class="max-w-6xl mx-auto px-6 lg:px-8 w-full">
    <div class="grid lg:grid-cols-2 gap-16 items-center">
      <div class="relative z-10 order-2 lg:order-1">
        <div
          class="inline-flex items-center gap-3 mb-8 px-4 py-2 bg-bibiche-vert/10 rounded-full"
        >
          <img src="/icone-vert.svg" alt="" class="w-6 h-6" />
          <span
            class="text-[10px] font-black uppercase tracking-[0.2em] text-bibiche-vert"
            >Cuisine de comptoir à Carros</span
          >
        </div>

        <h1
          class="font-display font-black text-5xl lg:text-7xl leading-tight text-black uppercase mb-8"
        >
          Manger <span class="text-bibiche-terra">vrai</span>,<br />
          manger <span class="text-bibiche-vert">frais</span>.
        </h1>

        <p
          class="text-lg text-black/60 font-medium max-w-lg leading-relaxed mb-10"
        >
          Une cuisine généreuse où chaque produit est sélectionné pour son goût.
          Profitez de votre pause déjeuner avec nos plats faits maison.
        </p>

        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href="#menu"
            class="bg-black text-white px-10 py-4 rounded-full font-black uppercase text-xs tracking-widest hover:bg-bibiche-terra transition-all text-center shadow-lg"
          >
            Découvrir la carte
          </a>
          <a
            href="tel:0400000000"
            class="border-2 border-black text-black px-10 py-4 rounded-full font-black uppercase text-xs tracking-widest hover:bg-black hover:text-white transition-all text-center"
          >
            Appeler pour commander
          </a>
        </div>
      </div>

      <div class="relative order-1 lg:order-2">
        <div
          class="relative rounded-[2.5rem] overflow-hidden shadow-2xl aspect-square lg:aspect-[4/5] max-h-[550px] mx-auto"
        >
          <img
            src="https://images.unsplash.com/photo-1512621776951-a57141f2eefd?auto=format&fit=crop&w=1000&q=80"
            alt="Plat frais Chez Bibiche"
            class="w-full h-full object-cover"
          />
        </div>
        <div
          class="absolute -bottom-6 -right-6 w-32 h-32 bg-bibiche-vert/20 rounded-full -z-10 blur-2xl"
        >
        </div>
      </div>
    </div>
  </div>
</section>
