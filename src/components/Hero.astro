---

---

<section
  class="relative bg-white pt-8 pb-20 lg:pt-12 lg:pb-24 overflow-hidden selection:bg-bibiche-vert selection:text-white min-h-[calc(100vh-5rem)]"
>
  <div class="max-w-6xl mx-auto px-6 lg:px-8 w-full">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-8 items-center">
      <div class="max-w-2xl relative z-10">
        <div class="inline-flex items-center gap-4 mb-6">
          <span class="w-10 h-[2px] bg-bibiche-vert"></span>
          <span
            class="text-[10px] md:text-xs font-bold uppercase tracking-[0.2em] text-bibiche-vert"
          >
            Z.A de la Grave
          </span>
        </div>

        <h1
          class="font-display font-black text-5xl lg:text-[4.5rem] leading-[1.05] tracking-tighter text-black mb-6 uppercase"
        >
          Le goût du <span class="text-bibiche-terra">vrai.</span><br />
          Sans attendre.
        </h1>

        <p
          class="text-base lg:text-lg text-black/70 font-medium leading-relaxed mb-8 max-w-lg"
        >
          Oubliez les pauses déjeuner sans saveur. Chez Bibiche, on vous prépare
          des plats faits maison pour recharger les batteries.
        </p>
      </div>

      <div class="relative lg:ml-10 mt-8 lg:mt-0 flex justify-center">
        <div
          class="absolute inset-0 bg-bibiche-vert/20 rounded-full blur-2xl lg:rounded-[3rem] rotate-3 scale-105 -z-10 max-w-[400px] mx-auto"
        >
        </div>

        <div
          class="relative rounded-[2rem] lg:rounded-[2.5rem] overflow-hidden shadow-2xl w-full max-w-[400px] max-h-[500px] aspect-[4/5] bg-black/5"
        >
          <img
            src="https://images.unsplash.com/photo-1512621776951-a57141f2eefd?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80"
            alt="Plat frais"
            class="w-full h-full object-cover"
          />
        </div>

        <div
          class="absolute bottom-4 -left-4 lg:bottom-12 lg:-left-8 bg-bibiche-vert text-white p-5 rounded-2xl shadow-xl z-20"
        >
          <p
            class="text-[10px] font-bold tracking-[0.2em] uppercase text-white/80 mb-1"
          >
            Service Midi
          </p>
          <p class="text-base font-bold tracking-tight">08h00 — 15h00</p>
        </div>
      </div>
    </div>
  </div>
</section>
