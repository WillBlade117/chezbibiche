---
---
<section class="relative bg-slate-50 pt-8 pb-20 lg:pt-12 lg:pb-24 overflow-hidden selection:bg-slate-900 selection:text-white min-h-[calc(100vh-5rem)]">  <div class="max-w-6xl mx-auto px-6 lg:px-8 w-full">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-8 items-center">
      
      <div class="max-w-2xl relative z-10">
        <div class="inline-flex items-center gap-4 mb-6">
          <span class="w-10 h-[2px] bg-amber-500"></span>
          <span class="text-[10px] md:text-xs font-bold uppercase tracking-[0.2em] text-amber-500">
            Nouveau à la Z.I de Carros
          </span>
        </div>
        
        <h1 class="font-display text-5xl lg:text-[4.5rem] leading-[1.05] tracking-tight text-slate-900 mb-6">
          Le goût du <span class="text-amber-500">vrai.</span><br />
          Sans attendre.
        </h1>
        
        <p class="text-base lg:text-lg text-slate-500 font-light leading-relaxed mb-8 max-w-lg">
          Oubliez les pauses déjeuner sans saveur. Chez Bibiche, on vous prépare des burgers généreux et des plats faits maison pour recharger les batteries avant de repartir.
        </p>
        
        <div class="flex flex-wrap items-center gap-6">
          <a href="#menu" class="bg-slate-900 text-white px-7 py-3.5 rounded-full text-xs font-bold uppercase tracking-[0.15em] hover:bg-amber-500 hover:text-slate-900 transition-all duration-300 shadow-lg hover:-translate-y-1">
            Voir la Carte
          </a>
          
          <a href="tel:0400000000" class="group flex items-center gap-3 text-sm font-bold uppercase tracking-widest text-slate-900 hover:text-amber-500 transition-colors">
            <span class="w-10 h-10 rounded-full border border-slate-200 flex items-center justify-center group-hover:border-amber-500 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
                <path fill-rule="evenodd" d="M2 3.5A1.5 1.5 0 013.5 2h1.148a1.5 1.5 0 011.465 1.175l.716 3.223a1.5 1.5 0 01-1.052 1.767l-.933.267c-.41.117-.643.555-.48.95a11.542 11.542 0 006.254 6.254c.395.163.833-.07.95-.48l.267-.933a1.5 1.5 0 011.767-1.052l3.223.716A1.5 1.5 0 0118 15.352V16.5a1.5 1.5 0 01-1.5 1.5H15c-1.149 0-2.263-.15-3.326-.43A13.022 13.022 0 012.43 8.326 13.019 13.019 0 012 5V3.5z" clip-rule="evenodd" />
              </svg>
            </span>
            Commander
          </a>
        </div>
      </div>

      <div class="relative lg:ml-10 mt-8 lg:mt-0 flex justify-center">
        <div class="absolute inset-0 bg-amber-100/50 rounded-[2rem] lg:rounded-[3rem] rotate-3 scale-105 -z-10 transition-transform duration-700 hover:rotate-2 max-w-[400px] mx-auto"></div>
        
        <div class="relative rounded-[1.5rem] lg:rounded-[2.5rem] overflow-hidden shadow-2xl w-full max-w-[400px] max-h-[500px] aspect-[4/5] bg-slate-200">
          <img 
            src="https://images.unsplash.com/photo-1586816001966-79b736744398?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80" 
            alt="Burger gourmet Chez Bibiche" 
            class="w-full h-full object-cover object-center hover:scale-105 transition-transform duration-1000 ease-out"
          />
          <div class="absolute inset-0 ring-1 ring-inset ring-slate-900/10 rounded-[1.5rem] lg:rounded-[2.5rem] pointer-events-none"></div>
        </div>
        
        <div class="absolute bottom-4 -left-4 lg:bottom-12 lg:-left-8 bg-white p-5 rounded-2xl shadow-xl border border-slate-50 hidden md:block z-20 hover:-translate-y-2 transition-transform duration-300">
          <p class="text-[10px] font-bold tracking-[0.2em] uppercase text-slate-400 mb-1">Service Midi</p>
          <p class="text-base font-bold text-slate-900 tracking-tight">08h00 — 15h00</p>
        </div>
      </div>
      
    </div>
  </div>
</section>