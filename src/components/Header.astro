---
interface NavLink {
  label: string;
  href: string;
}

const navLinks: NavLink[] = [
  { label: "La Carte", href: "#menu" },
  { label: "Infos & Accès", href: "#info" },
];
---

<header class="fixed top-0 w-full z-50 bg-white/90 backdrop-blur-lg border-b border-slate-200/50 transition-all duration-300">
  <div class="max-w-6xl mx-auto px-6 lg:px-8 h-20 flex items-center justify-between">
    
    <a href="/" class="font-display text-3xl text-amber-500 hover:text-amber-600 transition-colors tracking-wide shrink-0">
      Chez Bibiche.
    </a>

    <div class="flex items-center gap-8 lg:gap-10">
      
      <nav class="hidden md:flex items-center gap-8">
        {navLinks.map((link) => (
          <a 
            href={link.href} 
            class="text-xs font-bold uppercase tracking-[0.15em] text-slate-500 hover:text-slate-900 transition-colors"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <a 
        href="tel:0400000000" 
        class="group flex items-center gap-3 bg-slate-900 text-white px-6 py-3 rounded-full hover:bg-amber-500 transition-all duration-300 shadow-sm hover:shadow-md shrink-0"
        aria-label="Appeler pour commander"
      >
        <span class="text-xs font-bold uppercase tracking-[0.1em] group-hover:text-slate-900 transition-colors hidden xs:block">
          Commander
        </span>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 group-hover:text-slate-900 transition-colors">
          <path fill-rule="evenodd" d="M2 3.5A1.5 1.5 0 013.5 2h1.148a1.5 1.5 0 011.465 1.175l.716 3.223a1.5 1.5 0 01-1.052 1.767l-.933.267c-.41.117-.643.555-.48.95a11.542 11.542 0 006.254 6.254c.395.163.833-.07.95-.48l.267-.933a1.5 1.5 0 011.767-1.052l3.223.716A1.5 1.5 0 0118 15.352V16.5a1.5 1.5 0 01-1.5 1.5H15c-1.149 0-2.263-.15-3.326-.43A13.022 13.022 0 012.43 8.326 13.019 13.019 0 012 5V3.5z" clip-rule="evenodd" />
        </svg>
      </a>
      
    </div>
    
  </div>
</header>

<div class="h-20"></div>

<style>
  @media (max-width: 380px) {
    .xs\:block { display: none; }
  }
</style>