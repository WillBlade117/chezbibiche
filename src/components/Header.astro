---
interface Props {
  variant?: "light" | "dark";
}

const { variant = "light" } = Astro.props;

const headerClasses =
  variant === "dark"
    ? "bg-black/95 border-white/10"
    : "bg-white/95 border-black/5";

const textClasses =
  variant === "dark"
    ? "text-white/70 hover:text-bibiche-terra"
    : "text-black/60 hover:text-bibiche-terra";

const logoSrc = variant === "dark" ? "/logo-couleur.svg" : "/logo-marron.svg";

const navLinks = [
  { label: "Option 1 (Claire)", href: "/" },
  { label: "Option 2 (Bistrot)", href: "/option2" },
];
---

<header
  class={`fixed top-0 w-full z-50 backdrop-blur-md border-b transition-all duration-300 ${headerClasses}`}
>
  <div
    class="max-w-6xl mx-auto px-6 lg:px-8 h-20 flex items-center justify-between"
  >
    <a href="/" class="shrink-0 transition-transform hover:scale-105">
      <img src={logoSrc} alt="Chez Bibiche" class="h-10 md:h-12 w-auto" />
    </a>

    <div class="flex items-center gap-6 lg:gap-10">
      <nav class="hidden md:flex items-center gap-8">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class={`text-[10px] font-black uppercase tracking-[0.2em] transition-colors ${textClasses}`}
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <a
        href="tel:0400000000"
        class="bg-bibiche-terra text-white px-5 py-2.5 rounded-full text-[10px] font-black uppercase tracking-widest hover:bg-bibiche-vert transition-all shadow-lg active:scale-95"
      >
        Commander
      </a>
    </div>
  </div>
</header>

<div class="h-20"></div>
