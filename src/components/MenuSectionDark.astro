<section id="menu" class="bg-white py-20">
  <div class="text-center mb-16 lg:mb-24">
    <h2
      class="font-display font-black text-4xl lg:text-5xl text-black uppercase tracking-tighter mb-8"
    >
      Notre <span class="text-bibiche-terra">Carte</span>
    </h2>

    <div
      class="inline-block border border-black/10 p-6 rounded-xl shadow-sm bg-black/5"
    >
      <span
        class="text-[10px] font-black uppercase tracking-[0.2em] text-bibiche-terra mb-2 block"
      >
        Le Bon Plan
      </span>
      <p class="text-black/80 font-medium text-sm md:text-base">
        Achat groupé (Plat + Boisson + Dessert) =<br />
        <strong class="text-bibiche-terra font-black text-lg">-0,50 €</strong> de
        remise sur votre dessert.
      </p>
    </div>
  </div>
  <div class="max-w-4xl mx-auto px-6 lg:px-8">
    <div class="space-y-20">
      {
        categories.map((category) => (
          <div>
            <div class="flex flex-col items-center mb-12">
              <img
                src="/icone-couleur.svg"
                alt=""
                class="w-10 h-10 mb-4"
                aria-hidden="true"
              />
              <h3 class="font-display font-black text-3xl text-black uppercase tracking-tighter text-center">
                {category.title}
              </h3>
            </div>

            <div class="space-y-8">
              {category.items.map((item) => (
                <div class="group">
                  <div class="flex items-baseline justify-between gap-2 mb-1">
                    <h4 class="font-black text-black uppercase">{item.name}</h4>
                    <div class="grow border-b-2 border-dotted border-black/10 mx-2" />
                    <span class="font-black text-bibiche-terra shrink-0">
                      {item.price} €
                    </span>
                  </div>
                  {item.desc && (
                    <p class="text-black/50 text-sm italic">{item.desc}</p>
                  )}
                </div>
              ))}
            </div>
          </div>
        ))
      }

      <!-- Encart Sauces & Suppléments (Style Menu papier) -->
      <div
        class="mt-16 pt-12 border-t-2 border-dotted border-black/10 text-center"
      >
        <h3
          class="font-display font-black text-xl text-black uppercase tracking-widest mb-6"
        >
          Sauces & Suppléments
        </h3>
        <p class="text-sm text-black/70 mb-4 max-w-2xl mx-auto leading-relaxed">
          <strong class="uppercase tracking-wider text-black">Sauces :</strong> Mayonnaise,
          Ketchup, Moutarde, Samouraï, Algérienne, Harissa, Biggy, Blanche, Barbecue,
          Curry, Andalouse, Poivre.
        </p>
        <p class="text-sm text-black/70 max-w-2xl mx-auto">
          <strong class="uppercase tracking-wider text-black"
            >Suppléments :</strong
          > Fromage (1,00 €) <span class="mx-2">•</span> Viande (3,00 €) <span
            class="mx-2">•</span
          > Œuf (1,50 €)
        </p>
      </div>
    </div>
  </div>
</section>
