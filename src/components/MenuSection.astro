<section id="menu" class="bg-white py-20 border-b border-black/5">
  <div class="text-center max-w-2xl mx-auto mb-16 lg:mb-24">
    <h2
      class="font-display font-black text-4xl lg:text-5xl text-black uppercase tracking-tighter mb-8"
    >
      Notre <span class="text-bibiche-vert">Carte</span>
    </h2>

    <div
      class="inline-block bg-bibiche-vert/10 border border-bibiche-vert/30 p-6 rounded-2xl shadow-sm"
    >
      <span
        class="inline-block bg-bibiche-vert text-white text-[10px] font-black uppercase tracking-[0.2em] px-3 py-1 rounded-full mb-3"
      >
        Le Bon Plan
      </span>
      <p class="text-black/80 font-medium text-sm md:text-base">
        Pour l'achat d'un plat + une boisson + un dessert :<br />
        Profitez d'une remise immédiate de <strong
          class="text-bibiche-terra font-black text-lg">-0,50 €</strong
        > sur votre douceur !
      </p>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-6 lg:px-8">
    <div class="space-y-20">
      {
        categories.map((category) => (
          <div>
            <div class="flex items-center gap-4 mb-10">
              <img
                src="/icone-couleur.svg"
                alt=""
                class="w-8 h-8 opacity-80"
                aria-hidden="true"
              />
              <h3 class="font-display font-black text-2xl text-black uppercase tracking-tight">
                {category.title}
              </h3>
              <div class="h-px bg-black/10 grow" />
            </div>

            <div class="grid md:grid-cols-2 gap-4 lg:gap-6">
              {category.items.map((item) => (
                <div class="p-6 border border-black/5 rounded-xl hover:border-bibiche-vert/30 transition-all group">
                  <div class="flex justify-between items-start mb-2">
                    <h4 class="font-black text-black uppercase group-hover:text-bibiche-vert transition-colors">
                      {item.name}
                    </h4>
                    <span class="font-black text-bibiche-terra shrink-0 ml-4">
                      {item.price} €
                    </span>
                  </div>
                  {item.desc && (
                    <p class="text-black/60 text-sm">{item.desc}</p>
                  )}
                </div>
              ))}
            </div>
          </div>
        ))
      }

      <!-- Encart Sauces & Suppléments -->
      <div class="p-6 bg-black/5 rounded-xl border border-black/5 mt-12">
        <h3
          class="font-display font-black text-xl text-black uppercase tracking-tight mb-4"
        >
          Sauces & Suppléments
        </h3>
        <p class="text-sm text-black/80 mb-2">
          <strong>Sauces :</strong> Mayonnaise, Ketchup, Moutarde, Samouraï, Algérienne,
          Harissa, Biggy, Blanche, Barbecue, Curry, Andalouse, Poivre.
        </p>
        <p class="text-sm text-black/80">
          <strong>Suppléments :</strong> Fromage (1,00 €), Viande (3,00 €), Œuf (1,50
          €)
        </p>
      </div>
    </div>
  </div>
</section>
