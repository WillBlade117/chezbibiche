---

<section id="menu" class="py-20 lg:py-32 bg-[#FAFAFA] text-slate-900 selection:bg-slate-900 selection:text-white">
  <div class="max-w-6xl mx-auto px-6 lg:px-8">
    
    <div class="mb-16 md:w-2/3">
      <h2 class="text-xs font-bold tracking-[0.2em] uppercase text-slate-400 mb-6">
        La Carte
      </h2>
      <p class="text-4xl md:text-6xl font-medium tracking-tight leading-[1.1]">
        Généreux, fait maison.<br />
        <span class="text-slate-400 text-3xl md:text-5xl">Le choix sans compromis.</span>
      </p>
    </div>

    <div class="bg-slate-950 text-white rounded-[2rem] p-8 md:p-12 lg:p-16 mb-24 shadow-2xl relative overflow-hidden">
      <div class="absolute top-0 right-0 w-64 h-64 bg-amber-500/10 rounded-full blur-3xl -translate-y-1/2 translate-x-1/3 pointer-events-none"></div>
      
      <div class="flex flex-col md:flex-row md:items-end justify-between border-b border-white/10 pb-8 mb-10 relative z-10">
        <div>
          <h3 class="text-3xl md:text-4xl font-display text-amber-500 mb-3">Les Formules Midi</h3>
          <p class="text-slate-400 font-light max-w-lg">L'essentiel de Chez Bibiche, pensé pour votre pause déjeuner. Prêt rapidement.</p>
        </div>
        <div class="mt-6 md:mt-0">
          <span class="inline-block px-4 py-1 border border-white/20 rounded-full text-xs font-bold tracking-widest uppercase text-slate-300">
            Service Rapide
          </span>
        </div>
      </div>

      <div class="grid lg:grid-cols-3 gap-12 relative z-10">
        {formules.map((formule) => (
          <div class="group cursor-default">
            <h4 class="text-xl font-bold text-white mb-3 group-hover:text-amber-500 transition-colors">
              {formule.name}
            </h4>
            <p class="text-slate-400 text-sm font-light leading-relaxed mb-6 min-h-[4rem]">
              {formule.desc}
            </p>
            <div class="flex items-center gap-4">
              <span class="text-2xl font-light text-white">{formule.price} <span class="text-base text-amber-500">€</span></span>
              <div class="h-px bg-white/10 flex-1 group-hover:bg-amber-500/50 transition-colors"></div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="grid lg:grid-cols-2 gap-x-24 gap-y-24">
      {categories.map((cat) => (
        <div>
          <h3 class="text-3xl font-semibold tracking-tight mb-10 border-b border-slate-200 pb-6">
            {cat.title}
          </h3>
          <ul class="space-y-10">
            {cat.items.map((item) => (
              <li class="group cursor-default">
                <div class="flex justify-between items-baseline gap-4 mb-2">
                  <h4 class="text-lg font-medium text-slate-900 group-hover:text-amber-600 transition-colors duration-300 whitespace-nowrap">
                    {item.name}
                  </h4>
                  <div class="flex-1 border-b border-dotted border-slate-300 opacity-50 group-hover:opacity-100 transition-opacity"></div>
                  <span class="text-lg font-medium text-slate-900 whitespace-nowrap">
                    {item.price} <span class="text-sm text-slate-400 font-normal">€</span>
                  </span>
                </div>
                <p class="text-sm text-slate-500 font-light pr-12 leading-relaxed">
                  {item.desc}
                </p>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-32 pt-12 border-t border-slate-200 text-center">
      <p class="text-xs font-bold tracking-[0.15em] uppercase text-slate-400">
        Allergènes et provenances des viandes disponibles sur demande au comptoir.
      </p>
    </div>

  </div>
</section>