---

---

<section
  class="relative bg-black h-[calc(100vh-5rem)] min-h-[600px] overflow-hidden flex items-center selection:bg-bibiche-terra"
>
  <div class="absolute inset-0 z-0">
    <img
      src="https://images.unsplash.com/photo-1586816001966-79b736744398?auto=format&fit=crop&w=1920&q=80"
      alt=""
      class="w-full h-full object-cover opacity-50"
    />
    <div
      class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-black/70"
    >
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-6 text-center relative z-10">
    <div class="mb-6 inline-block">
      <img
        src="/icone-marron.svg"
        alt=""
        class="w-16 h-16 mx-auto drop-shadow-2xl"
      />
    </div>

    <h1
      class="font-display font-black text-5xl lg:text-8xl leading-none text-white uppercase tracking-tighter mb-6"
    >
      L'Art du <span class="text-bibiche-terra text-shadow-lg">Fait Maison</span
      >
    </h1>

    <div class="inline-block border-y border-white/20 py-3 px-6 mb-8">
      <p
        class="text-sm lg:text-base text-white font-bold uppercase tracking-[0.3em]"
      >
        Snack • Burger • Fraîcheur
      </p>
    </div>

    <p
      class="text-white/80 text-sm lg:text-lg max-w-xl mx-auto leading-relaxed mb-10"
    >
      Une expérience gourmande au cœur de la Zone de la Grave. Plats préparés
      avec passion pour votre pause déjeuner.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href="#menu"
        class="w-full sm:w-auto bg-bibiche-terra text-white px-10 py-4 font-black uppercase text-[10px] tracking-[0.2em] hover:bg-white hover:text-black transition-all shadow-2xl"
      >
        Découvrir la carte
      </a>
      <a
        href="tel:0400000000"
        class="w-full sm:w-auto border border-white/50 text-white px-10 py-4 font-black uppercase text-[10px] tracking-[0.2em] hover:bg-white hover:text-black transition-all backdrop-blur-sm"
      >
        Commander
      </a>
    </div>
  </div>

  <div class="absolute bottom-8 right-8 hidden lg:block opacity-80">
    <div
      class="w-24 h-24 rounded-full border border-dashed border-bibiche-terra/50 flex items-center justify-center rotate-12"
    >
      <span
        class="text-bibiche-terra font-black text-[8px] uppercase tracking-widest text-center leading-tight"
        >Produits<br />100% Frais</span
      >
    </div>
  </div>
</section>

<style>
  .text-shadow-lg {
    text-shadow: 0 4px 12px rgba(0, 0, 0, 0.5);
  }
</style>
