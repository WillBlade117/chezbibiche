---
import '../styles/global.css';

interface Props {
  title: string;
  description? : string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="fr" class="scroll-smooth"> <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Chez Bibiche - Votre snack gourmand au cœur de la Zone Industrielle de Carros. Produits frais et service rapide." />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&family=Pacifico&display=swap" rel="stylesheet">
    <title>{title}</title>
  </head>
  <body class="bg-slate-50 text-slate-900 font-sans min-h-screen flex flex-col">
    
    <slot />

  </body>
</html>